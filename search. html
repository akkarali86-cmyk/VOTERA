<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>البحث عن مستخدم — VOTERA</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>

:root{
  --primary:#6c5ce7;
  --primary-dark:#5848d6;
  --bg:#f7f7fb;
  --card:#ffffff;
  --text:#17171c;
  --muted:#777783;
  --border:#e8e8ef;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  background:var(--bg);
  min-height:100%;
}

body{

  font-family:Arial,Helvetica,sans-serif;

  background:var(--bg);

  color:var(--text);

  min-height:100vh;

  padding-bottom:110px;

}

button,
input{
  font-family:inherit;
}

button{
  border:0;
  cursor:pointer;
}

a{
  text-decoration:none;
  color:inherit;
}


/* =========================================
   HEADER
========================================= */

header{

  height:68px;

  background:#fff;

  border-bottom:1px solid var(--border);

  display:flex;

  align-items:center;

  position:sticky;

  top:0;

  z-index:100;

}

.nav{

  width:100%;

  max-width:900px;

  margin:auto;

  padding:0 18px;

  display:flex;

  align-items:center;

  justify-content:space-between;

}

.logo{

  font-size:25px;

  font-weight:950;

  letter-spacing:-1px;

  direction:ltr;

}

.logo span{

  color:var(--primary);

}

.back-link{

  color:var(--muted);

  font-size:13px;

  font-weight:900;

}


/* =========================================
   CONTAINER
========================================= */

.container{

  width:100%;

  max-width:650px;

  margin:auto;

  padding:30px 18px;

}


/* =========================================
   TITLE
========================================= */

.title{

  text-align:center;

  margin-bottom:22px;

}

.title h1{

  font-size:25px;

  font-weight:950;

  margin-bottom:8px;

}

.title p{

  color:var(--muted);

  font-size:13px;

}


/* =========================================
   SEARCH BOX
========================================= */

.search-box{

  background:#fff;

  border:1px solid var(--border);

  border-radius:18px;

  padding:10px;

  display:flex;

  align-items:center;

  gap:8px;

  box-shadow:0 7px 22px rgba(0,0,0,.035);

  margin-bottom:18px;

}

.search-icon{

  width:40px;

  height:40px;

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:20px;

  flex-shrink:0;

}

.search-input{

  flex:1;

  border:0;

  outline:0;

  background:transparent;

  font-size:14px;

  direction:rtl;

  min-width:0;

}

.search-input::placeholder{

  color:#9999a3;

}

.search-button{

  background:var(--primary);

  color:white;

  border-radius:12px;

  padding:11px 16px;

  font-size:12px;

  font-weight:950;

}

.search-button:active{

  transform:scale(.96);

}


/* =========================================
   RESULTS
========================================= */

.results-title{

  display:flex;

  justify-content:space-between;

  align-items:center;

  margin:18px 2px 12px;

}

.results-title h2{

  font-size:18px;

  font-weight:950;

}

.results-count{

  color:var(--primary);

  font-size:11px;

  font-weight:900;

}


/* =========================================
   USER CARD
========================================= */

.users{

  display:flex;

  flex-direction:column;

  gap:10px;

}

.user-card{

  background:#fff;

  border:1px solid var(--border);

  border-radius:18px;

  padding:14px;

  display:flex;

  align-items:center;

  gap:12px;

  transition:.2s;

}

.user-card:hover{

  border-color:#d6d0ff;

  transform:translateY(-1px);

}

.user-card:active{

  transform:scale(.98);

}


/* =========================================
   AVATAR
========================================= */

.avatar{

  width:55px;

  height:55px;

  border-radius:50%;

  background:#ece9ff;

  color:var(--primary);

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:23px;

  font-weight:950;

  overflow:hidden;

  flex-shrink:0;

}

.avatar img{

  width:100%;

  height:100%;

  object-fit:cover;

}


/* =========================================
   USER INFO
========================================= */

.user-info{

  flex:1;

  min-width:0;

}

.display-name{

  font-size:15px;

  font-weight:950;

  margin-bottom:4px;

  overflow:hidden;

  text-overflow:ellipsis;

  white-space:nowrap;

}

.username{

  direction:ltr;

  text-align:right;

  color:var(--primary);

  font-size:11px;

  font-weight:800;

  margin-bottom:5px;

}

.bio{

  color:var(--muted);

  font-size:10px;

  overflow:hidden;

  text-overflow:ellipsis;

  white-space:nowrap;

}


/* =========================================
   OPEN BUTTON
========================================= */

.open-profile{

  background:#f0eeff;

  color:var(--primary);

  border:1px solid #ddd8ff;

  border-radius:11px;

  padding:9px 11px;

  font-size:10px;

  font-weight:950;

  flex-shrink:0;

}


/* =========================================
   EMPTY
========================================= */

.empty{

  background:#fff;

  border:1px solid var(--border);

  border-radius:18px;

  padding:35px 18px;

  text-align:center;

  color:var(--muted);

  font-size:13px;

  line-height:1.8;

}


/* =========================================
   MESSAGE
========================================= */

.message{

  display:none;

  background:#fff0f0;

  color:#b42318;

  border:1px solid #ffd0d0;

  border-radius:13px;

  padding:12px;

  text-align:center;

  font-size:12px;

  font-weight:800;

  margin-bottom:15px;

}

.message.show{

  display:block;

}


/* =========================================
   BOTTOM NAV
========================================= */

.bottom-nav{

  position:fixed;

  left:0;

  right:0;

  bottom:0;

  width:100%;

  height:82px;

  background:#fff;

  border-top:1px solid var(--border);

  box-shadow:0 -6px 25px rgba(0,0,0,.10);

  z-index:9999;

}

.bottom-nav-inner{

  width:100%;

  max-width:650px;

  height:100%;

  margin:auto;

  display:grid;

  grid-template-columns:repeat(5,1fr);

  align-items:center;

}

.bottom-item{

  height:82px;

  display:flex;

  flex-direction:column;

  align-items:center;

  justify-content:center;

  gap:5px;

  color:#858592;

  font-size:10px;

  font-weight:900;

}

.bottom-item.active{

  color:var(--primary);

}

.bottom-icon{

  width:28px;

  height:28px;

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:21px;

}

.bottom-label{

  font-size:10px;

  white-space:nowrap;

}

.bottom-create{

  width:52px;

  height:52px;

  border-radius:17px;

  background:var(--primary);

  color:white;

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:28px;

  margin-top:-22px;

  box-shadow:0 8px 22px rgba(108,92,231,.32);

}


/* =========================================
   MOBILE
========================================= */

@media(max-width:420px){

  .search-button{

    padding:11px 12px;

  }

  .open-profile{

    padding:8px 8px;

  }

  .user-card{

    padding:12px;

  }

}

</style>

</head>


<body>


<!-- =====================================
     HEADER
===================================== -->

<header>

<nav class="nav">

<a href="index.html"
   class="logo">

VOTE<span>RA</span>

</a>


<a href="index.html"
   class="back-link">

الرئيسية 🏠

</a>

</nav>

</header>



<!-- =====================================
     MAIN
===================================== -->

<main class="container">


<div class="title">

<h1>
🔍 البحث عن مستخدم
</h1>

<p>
ابحث عن الأشخاص في مجتمع VOTERA
</p>

</div>


<div
id="message"
class="message">
</div>



<!-- =====================================
     SEARCH
===================================== -->

<div class="search-box">

<div class="search-icon">
🔍
</div>


<input
id="searchInput"
class="search-input"
type="text"
placeholder="اكتب اسم المستخدم..."
autocomplete="off"
>


<button
class="search-button"
onclick="searchUsers()">

بحث

</button>

</div>



<!-- =====================================
     RESULTS TITLE
===================================== -->

<div class="results-title">

<h2>
المستخدمون
</h2>

<span
id="resultsCount"
class="results-count">

0 نتيجة

</span>

</div>



<!-- =====================================
     RESULTS
===================================== -->

<div
id="usersList"
class="users">

<div class="empty">

🔎

<br><br>

اكتب اسم المستخدم للبحث عنه.

</div>

</div>


</main>



<!-- =====================================
     BOTTOM NAV
===================================== -->

<nav class="bottom-nav">

<div class="bottom-nav-inner">


<a
href="index.html"
class="bottom-item">

<div class="bottom-icon">
🏠
</div>

<div class="bottom-label">
الرئيسية
</div>

</a>


<a
href="search.html"
class="bottom-item active">

<div class="bottom-icon">
🌎
</div>

<div class="bottom-label">
استكشاف
</div>

</a>


<a
href="create.html"
class="bottom-item">

<div class="bottom-create">
＋
</div>

<div class="bottom-label">
إنشاء
</div>

</a>


<a
href="index.html#votes"
class="bottom-item">

<div class="bottom-icon">
🗳️
</div>

<div class="bottom-label">
التصويتات
</div>

</a>


<a
href="profile.html"
class="bottom-item">

<div class="bottom-icon">
👤
</div>

<div class="bottom-label">
حسابي
</div>

</a>


</div>

</nav>



<script>

/* =========================================
   SUPABASE
========================================= */

const SUPABASE_URL =
"https://vatlwkuagxyrvwclttfz.supabase.co";


const SUPABASE_ANON_KEY =
"sb_publishable_7zlCZUTtFzvs_Ytv5XnvEg_y6tOWY94";


const supabaseClient =
window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_ANON_KEY
);


/* =========================================
   ELEMENTS
========================================= */

const searchInput =
document.getElementById(
  "searchInput"
);


const usersList =
document.getElementById(
  "usersList"
);


const resultsCount =
document.getElementById(
  "resultsCount"
);


const message =
document.getElementById(
  "message"
);


/* =========================================
   MESSAGE
========================================= */

function showMessage(text){

  message.textContent =
    text;

  message.classList.add(
    "show"
  );

}


function hideMessage(){

  message.classList.remove(
    "show"
  );

}


/* =========================================
   SEARCH USERS
========================================= */

async function searchUsers(){

  hideMessage();


  const query =
    searchInput.value.trim();


  /* البحث فارغ */

  if(!query){

    resultsCount.textContent =
      "0 نتيجة";


    usersList.innerHTML = `

      <div class="empty">

        🔎

        <br><br>

        اكتب اسم المستخدم للبحث عنه.

      </div>

    `;

    return;

  }


  usersList.innerHTML = `

    <div class="empty">

      ⏳

      <br><br>

      جارٍ البحث...

    </div>

  `;


  try{

    /*
      نبحث في:
      username
      display_name
    */

    const usernameSearch =
      `%${query}%`;


    const displaySearch =
      `%${query}%`;


    const {

      data,

      error

    } =

    await supabaseClient

      .from("profiles")

      .select(
        "id, username, display_name, avatar_url, bio, points"
      )

      .or(
        "username.ilike." +
        usernameSearch +
        ",display_name.ilike." +
        displaySearch
      )

      .limit(30);


    if(error){

      throw error;

    }


    const users =
      data || [];


    resultsCount.textContent =
      users.length +
      " نتيجة";


    if(users.length === 0){

      usersList.innerHTML = `

        <div class="empty">

          😕
          
          <br><br>

          لم نجد أي مستخدم بهذا الاسم.

          <br>

          جرّب اسم مستخدم آخر.

        </div>

      `;

      return;

    }


    usersList.innerHTML =
      "";


    users.forEach(
      function(user){

        const card =
          document.createElement("a");


        card.className =
          "user-card";


        /*
          أهم جزء:

          عند الضغط على المستخدم
          نفتح profile.html
          ونرسل id الخاص به.
        */

        card.href =
          "profile.html?id=" +
          encodeURIComponent(
            user.id
          );


        /* =========================
           AVATAR
        ========================= */

        const avatar =
          document.createElement("div");


        avatar.className =
          "avatar";


        if(user.avatar_url){

          const img =
            document.createElement("img");


          img.src =
            user.avatar_url;


          img.alt =
            "صورة المستخدم";


          img.onerror =
          function(){

            avatar.textContent =
              "👤";

          };


          avatar.appendChild(
            img
          );

        }else{

          avatar.textContent =
            "👤";

        }


        /* =========================
           USER INFO
        ========================= */

        const info =
          document.createElement("div");


        info.className =
          "user-info";


        const displayName =
          document.createElement("div");


        displayName.className =
          "display-name";


        displayName.textContent =
          user.display_name ||
          user.username ||
          "مستخدم VOTERA";


        const username =
          document.createElement("div");


        username.className =
          "username";


        username.textContent =
          user.username
          ? "@" + user.username
          : "";


        const bio =
          document.createElement("div");


        bio.className =
          "bio";


        bio.textContent =
          user.bio ||
          "عضو في VOTERA";


        info.appendChild(
          displayName
        );


        info.appendChild(
          username
        );


        info.appendChild(
          bio
        );


        /* =========================
           OPEN BUTTON
        ========================= */

        const openButton =
          document.createElement("div");


        openButton.className =
          "open-profile";


        openButton.textContent =
          "عرض الملف";


        /* =========================
           CARD
        ========================= */

        card.appendChild(
          avatar
        );


        card.appendChild(
          info
        );


        card.appendChild(
          openButton
        );


        usersList.appendChild(
          card
        );

      }
    );


  }catch(error){

    console.error(
      "Search users error:",
      error
    );


    resultsCount.textContent =
      "0 نتيجة";


    usersList.innerHTML = `

      <div class="empty">

        ❌

        <br><br>

        تعذر البحث عن المستخدمين.

        <br><br>

        ${escapeHtml(
          error.message || ""
        )}

      </div>

    `;

  }

}


/* =========================================
   ENTER KEY
========================================= */

searchInput.addEventListener(
  "keydown",
  function(event){

    if(event.key === "Enter"){

      searchUsers();

    }

  }
);


/* =========================================
   SECURITY
========================================= */

function escapeHtml(text){

  const div =
    document.createElement("div");


  div.textContent =
    String(text);


  return div.innerHTML;

}

</script>

</body>

</html>
